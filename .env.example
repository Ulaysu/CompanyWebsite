# Canonical production URL (no trailing slash). Used for canonical + Open Graph URLs, the sitemap and robots.txt.
VITE_SITE_URL=

# Company-controlled inbox, shown on the site and used as the mailto fallback.
# Leave empty until the real address exists: no email is shown and no placeholder is used.
VITE_CONTACT_EMAIL=

# Form backend that accepts JSON POSTs (Formspree, Basin, your own API).
# When unset, the enquiry form falls back to a pre-filled email (if VITE_CONTACT_EMAIL is set),
# otherwise it states that backend integration is still required and sends nothing.
VITE_CONTACT_ENDPOINT=

# Optional company social profile URLs. Unset ones are hidden.
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
